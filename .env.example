# TraceBack AI Environment Configuration

# Multimodal AI API (Google Gemini 2.0 Flash)
# If left empty, TraceBack automatically runs in high-fidelity Demo Simulation Mode!
GEMINI_API_KEY=

# Supabase PostgreSQL & Storage (Optional for production multi-tenant cloud storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Map Provider (Optional for live satellite tiles, interactive SVG campus map is enabled by default)
MAPBOX_ACCESS_TOKEN=

# Backend server
HOST=127.0.0.1
PORT=8000
JWT_SECRET=traceback-secure-key-hackathon-2026
